# =============================================================================
# Agentic AI Property Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# OpenAI Configuration
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=propertyai
POSTGRES_PASSWORD=propertyai_secret_2024_change_in_production
POSTGRES_DB=bangalore_properties
POSTGRES_MAX_CONNECTIONS=100

# =============================================================================
# Elasticsearch Configuration
# =============================================================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTIC_PASSWORD=elastic_secret_2024_change_in_production
ELASTICSEARCH_CLUSTER_NAME=property-search-cluster

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2024_change_in_production
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Pinecone Configuration (Optional - for vector search)
# =============================================================================
# Get your API key from https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENV=us-west1-gcp
PINECONE_INDEX_NAME=bangalore-properties
# Set to "true" to use Pinecone, "false" to use local alternative
USE_PINECONE=false

# =============================================================================
# Application Ports
# =============================================================================
BACKEND_PORT=8080
AI_AGENT_PORT=8000
FRONTEND_PORT=3000

# =============================================================================
# Application Environment
# =============================================================================
NODE_ENV=development
SPRING_PROFILES_ACTIVE=local
PYTHON_ENV=development

# =============================================================================
# API Configuration
# =============================================================================
# Backend API URL (used by frontend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# AI Agent API URL (used by backend)
AI_AGENT_URL=http://ai-agents:8000

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
# Options: TRACE, DEBUG, INFO, WARN, ERROR
SPRING_LOG_LEVEL=INFO
PYTHON_LOG_LEVEL=INFO

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_CACHING=true
ENABLE_VECTOR_SEARCH=false
ENABLE_REAL_TIME_DATA=false
ENABLE_STREAMING=true

# =============================================================================
# Performance Configuration
# =============================================================================
# Virtual threads (Java 21 Project Loom)
USE_VIRTUAL_THREADS=true
# Agent execution timeout (seconds)
AGENT_TIMEOUT_SECONDS=30
# Max properties to analyze per query
MAX_PROPERTIES_TO_ANALYZE=50

# =============================================================================
# Security Configuration
# =============================================================================
# JWT secret for authentication (generate a strong random string)
JWT_SECRET=your-jwt-secret-key-min-256-bits-change-in-production
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Mapbox Configuration (Optional - for maps)
# =============================================================================
# Get your token from https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# =============================================================================
# External APIs (Optional)
# =============================================================================
# For real-time property data integration
PROPERTY_API_KEY=your-property-api-key-here
MAPS_API_KEY=your-maps-api-key-here

# =============================================================================
# Monitoring & Observability (Production)
# =============================================================================
# Application Performance Monitoring
APM_ENABLED=false
APM_SERVICE_NAME=property-ai-platform
APM_ENVIRONMENT=local

# Metrics
METRICS_ENABLED=true
METRICS_EXPORT_INTERVAL_SECONDS=60

# =============================================================================
# Docker Compose Configuration
# =============================================================================
COMPOSE_PROJECT_NAME=property-ai-platform
DOCKER_BUILDKIT=1
